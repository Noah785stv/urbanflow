# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://urbanflow:urbanflow@localhost:5432/urbanflow
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=urbanflow
POSTGRES_DB=urbanflow

# Redis
REDIS_URL=redis://localhost:6379

# Auth — génère une vraie valeur : openssl rand -base64 32
JWT_SECRET=change-me-en-local-et-ne-jamais-committer
JWT_EXPIRES_IN=15m