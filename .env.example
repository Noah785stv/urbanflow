# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://urbanflow:urbanflow@127.0.0.1:5433/urbanflow
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=urbanflow
POSTGRES_DB=urbanflow

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth — génère une vraie valeur : openssl rand -base64 32
JWT_SECRET=change-me-en-local-et-ne-jamais-committer
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-en-local-et-ne-jamais-committer
JWT_REFRESH_EXPIRES_IN=7d

# Chiffrement domicile/travail (AES-256-GCM) — 32 octets base64 : openssl rand -base64 32
ENCRYPTION_KEY=change-me-en-local-et-ne-jamais-committer